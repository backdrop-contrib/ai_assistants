<?php

/**
 * Implements hook_install().
 */
function ai_assistants_install() {
  if (!module_load_install('ai_upgrade')) { return []; }
  ai_upgrade_module_install('ai_assistant');
}

/**
 * Implements hook_uninstall().
 */
function ai_assistants_uninstall() {
  // Per-assistant configs are declared in hook_config_info() without a
  // name_key (they carry no id attribute), so core does not remove them.
  foreach (config_get_names_with_prefix('ai_assistants.assistant.') as $config_name) {
    config($config_name)->delete();
  }
}


/**
 * Superseded by ai_assistants_update_1003().
 */
function ai_assistants_update_1000() {
  return t('Superseded by update 1003.');
}

/**
 * Migrate assistant definitions into one config object per assistant.
 */
function ai_assistants_update_1001() {
  module_load_include('inc', 'ai_assistants', 'includes/ai_assistants.config');

  $legacy = ai_assistants_get_legacy_assistants();
  if (empty($legacy)) {
    return t('Assistant config already uses per-assistant config objects.');
  }

  foreach ($legacy as $assistant_id => $assistant) {
    if (!is_array($assistant) || $assistant_id === '') {
      continue;
    }
    ai_assistants_save_assistant($assistant_id, $assistant);
  }

  config_clear('ai_assistants.settings', 'assistants');
  return t('Migrated assistant definitions into per-assistant config objects.');
}

/**
 * Replace single-column assistant_id index with compound (assistant_id, updated).
 */
function ai_assistants_update_1002() {
  if (db_index_exists('ai_assistants_thread', 'assistant_id')) {
    db_drop_index('ai_assistants_thread', 'assistant_id');
  }
  if (!db_index_exists('ai_assistants_thread', 'assistant_id_updated')) {
    db_add_index('ai_assistants_thread', 'assistant_id_updated', ['assistant_id', 'updated']);
  }
  return t('Replaced assistant_id index with compound assistant_id_updated index on ai_assistants_thread.');
}

/**
 * Qualify unprefixed assistant models as openai/<model>.
 *
 * The legacy suite sent unprefixed models to OpenAI; the AI suite sends them
 * to the first enabled provider. The admin UI always saves prefixed IDs, so
 * unprefixed values can only come from migrated legacy config.
 */
function ai_assistants_update_1003() {
  if (!module_load_install('ai_upgrade')) {
    return t('AI Upgrade helpers unavailable; assistant models not checked.');
  }
  $changed = 0;

  $settings = config('ai_assistants.settings');
  $legacy = $settings->get('assistants');
  if (is_array($legacy) && ($count = _ai_upgrade_qualify_item_models($legacy))) {
    $settings->set('assistants', $legacy)->save();
    $changed += $count;
  }

  foreach (config_get_names_with_prefix('ai_assistants.assistant.') as $name) {
    $config = config($name);
    $model = $config->get('model');
    $qualified = _ai_upgrade_qualify_model($model);
    if ($qualified !== $model) {
      $config->set('model', $qualified)->save();
      $changed++;
    }
  }

  return t('Qualified @count unprefixed assistant model(s) with the openai/ provider prefix.', ['@count' => $changed]);
}

/**
 * Implements hook_update_dependencies().
 */
function ai_assistants_update_dependencies() {
  // Update 1004 routes to agents that ai_agents_update_1005() creates.
  $dependencies['ai_assistants'][1004] = [
    'ai_agents' => 1005,
  ];
  return $dependencies;
}

/**
 * Route the default assistant to the node, paragraph, menu, and layout agents.
 *
 * Only these agents are added: they were never shipped before, so an admin
 * cannot have removed them on purpose. The delete sentence in the system
 * prompt is replaced only if the prompt still has the shipped wording.
 */
function ai_assistants_update_1004() {
  $config = config('ai_assistants.assistant.backdrop_agent_assistant');
  if ($config->isNew()) {
    return t('Default assistant not present; nothing to update.');
  }

  $existing_agents = module_exists('ai_agents') ? config_get('ai_agents.settings', 'agents') : [];
  $agent_ids = $config->get('agent_ids');
  $agent_ids = is_array($agent_ids) ? $agent_ids : [];
  $added = [];
  foreach (['node_agent', 'paragraph_agent', 'menu_agent', 'layout_agent'] as $agent_id) {
    if (isset($existing_agents[$agent_id]) && !in_array($agent_id, $agent_ids, TRUE)) {
      $agent_ids[] = $agent_id;
      $added[] = $agent_id;
    }
  }
  if ($added) {
    $config->set('agent_ids', $agent_ids);
  }

  $old = '(For now you cannot delete anything yourself — tell them and offer to walk them through it.)';
  $new = '(You can only delete menu links and remove blocks from layouts, and only after the user approves. For anything else, tell them and offer to walk them through it.)';
  $prompt = (string) $config->get('system_prompt');
  $prompt_updated = strpos($prompt, $old) !== FALSE;
  if ($prompt_updated) {
    $config->set('system_prompt', str_replace($old, $new, $prompt));
  }

  if ($added || $prompt_updated) {
    $config->save();
  }
  return t('Default assistant: added @agents; delete guidance @prompt.', [
    '@agents' => $added ? implode(', ', $added) : t('no agents'),
    '@prompt' => $prompt_updated ? t('updated') : t('left unchanged'),
  ]);
}

/**
 * Implements hook_requirements().
 */
function ai_assistants_requirements($phase) {
  if (!module_load_install('ai_upgrade')) { return []; }
  return ai_upgrade_module_requirements($phase, 'ai_assistant');
}
